<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>buddy_orchestrator</name>
  <version>0.1.0</version>
  <description>
    Central coordinator for the BUDDY robot dog. It connects the voice,
    vision and navigation components through the documented interfaces,
    arbitrates the speaker, camera and motion ownership rules, and never
    touches a device or a motor itself.
  </description>
  <maintainer email="yohanwick17@gmail.com">S. S. Y. Wickramasinghe</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>buddy_core</exec_depend>
  <exec_depend>buddy_interfaces</exec_depend>
  <exec_depend>buddy_nav_interfaces</exec_depend>
  <exec_depend>buddy_navigation</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
